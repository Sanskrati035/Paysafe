# PAYSAFE backend configuration
# ------------------------------------------------------------
# If ANTHROPIC_API_KEY is left blank, the AI agent automatically falls
# back to a deterministic rule-based classifier so the whole app
# still works offline with zero external dependencies / zero cost.
# Rule-based classification always handles known payment codes first;
# the LLM (when configured) is only invoked for ambiguous free-text
# customer complaints.
# ------------------------------------------------------------

# Optional: Anthropic API key. NEVER exposed to the frontend — only read
# server-side by app/config.py. Leave blank to run fully offline.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for ambiguous-complaint reasoning.
LLM_MODEL=claude-sonnet-4-6

# How often (seconds) the single background monitor agent scans transactions.
AGENT_SCAN_INTERVAL_SECONDS=30

# SQLite DB path (relative to backend/ when run locally)
DATABASE_URL=sqlite:///./paysafe.db

# Comma-separated list of allowed CORS origins for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
